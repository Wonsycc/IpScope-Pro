<Window x:Class="IpScopePro.Views.InstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:IpScopePro.Converters"
        Title="{converters:Translate Key=InstallTitle}" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Segoe UI" FontSize="12">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                       GlassFrameThickness="0" CornerRadius="12" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{converters:Translate Key=InstallTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource WindowFg}" VerticalAlignment="Center" Margin="12,0" />
                    <Button Grid.Column="1" Content="✕" Width="36" Height="30"
                            Style="{DynamicResource FlatButton}"
                            Foreground="{DynamicResource RedColor}" FontSize="14" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12">
                <GroupBox Style="{StaticResource ThemedGroupBox}">
                    <GroupBox.Header>
                        <TextBlock Text="{converters:Translate Key=InstallLocation}" Foreground="{DynamicResource AccentColor}" />
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPathBox" Grid.Column="0" Style="{StaticResource ThemedTextBox}"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="{converters:Translate Key=Browse}" MinWidth="90" Height="28"
                                    Margin="8,0,0,0" Style="{DynamicResource FlatButton}" Padding="10,4"
                                    Foreground="{DynamicResource AccentColor}" FontSize="11"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Click="Browse_Click" />
                        </Grid>
                        <TextBlock Text="{converters:Translate Key=InstallHintAdmin}" Foreground="{DynamicResource MutedFg}"
                                   TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Style="{StaticResource ThemedGroupBox}" Margin="0,12,0,0">
                    <GroupBox.Header>
                        <TextBlock Text="{converters:Translate Key=ShortcutsGroup}" Foreground="{DynamicResource AccentColor}" />
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <CheckBox x:Name="DesktopShortcutBox" Content="{converters:Translate Key=DesktopShortcut}"
                                  IsChecked="True" Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                        <CheckBox x:Name="StartMenuShortcutBox" Content="{converters:Translate Key=StartMenuShortcut}"
                                  IsChecked="True" Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <Border Grid.Row="2" Padding="14" Background="{DynamicResource TitleBarBg}" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{converters:Translate Key=Cancel}" MinWidth="90" Height="34"
                            Style="{DynamicResource FlatButton}" Padding="10,4"
                            Foreground="{DynamicResource SubtleFg}" FontSize="12" Click="Cancel_Click" />
                    <Button Content="{converters:Translate Key=InstallApp}" MinWidth="120" Height="34" Margin="10,0,0,0"
                            Style="{DynamicResource AccentButton}" Padding="10,4"
                            FontSize="12" Click="Install_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
