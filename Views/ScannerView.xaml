<UserControl x:Class="IpScopePro.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:IpScopePro.Converters"
             xmlns:vm="clr-namespace:IpScopePro.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:PercentageConverter x:Key="PercentConv" />
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Controls Card -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" Padding="16"
                CornerRadius="12" Margin="0,0,0,4"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.15" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{converters:Translate Key=IpRange}" Foreground="{DynamicResource SubtleFg}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="ⓘ" FontSize="13" Foreground="{DynamicResource BlueColor}"
                               VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Help"
                               ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="10000">
                        <TextBlock.ToolTip>
                            <TextBlock FontSize="12" Foreground="{DynamicResource WindowFg}"
                                       Text="{converters:Translate Key=IpRangeTip}" />
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Text="{Binding IpRangeInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ThemedTextBox}" FontSize="13" Width="320" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <CheckBox Content="{converters:Translate Key=Ports}" IsChecked="{Binding ScanPorts}"
                              Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center" Margin="0,0,12,0"
                              Style="{DynamicResource ThemedCheckBox}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ScanPorts, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding ScanModes}"
                                  SelectedIndex="{Binding SelectedScanModeIndex}"
                                  Width="110" Style="{DynamicResource ThemedComboBox}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="ⓘ" FontSize="13" Foreground="{DynamicResource BlueColor}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Help"
                                   ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="10000">
                            <TextBlock.ToolTip>
                                <TextBlock FontSize="12" Foreground="{DynamicResource WindowFg}"
                                           Text="{converters:Translate Key=ScanModeTip}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Button Content="{converters:Translate Key=Scan}" MinWidth="100" Height="34"
                            Style="{DynamicResource AccentButton}" Padding="8,0"
                            Command="{Binding StartScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Content="{converters:Translate Key=StopScan}" MinWidth="100" Height="34"
                            Style="{DynamicResource DangerButton}" Padding="8,0"
                            Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal"
                            Margin="0,12,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ScanPorts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{converters:Translate Key=PortsToScan}" Foreground="{DynamicResource SubtleFg}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="ⓘ" FontSize="13" Foreground="{DynamicResource BlueColor}"
                               VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Help"
                               ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="10000">
                        <TextBlock.ToolTip>
                            <TextBlock FontSize="12" Foreground="{DynamicResource WindowFg}"
                                       Text="{converters:Translate Key=PortsToScanTip}" />
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Text="{Binding PortsInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ThemedTextBox}" FontSize="12" Width="200" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar Card -->
        <Border Grid.Row="1" Padding="12,6" CornerRadius="0,0,12,12"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent}" Maximum="100"
                             Style="{DynamicResource ThemedProgressBar}" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Converter={StaticResource PercentConv}}"
                           Foreground="{DynamicResource AccentColor}" FontSize="11" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Padding="8,5" Background="{DynamicResource SurfaceBg}"
                        CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ShowAliveOnly" Content="{converters:Translate Key=ShowAliveOnly}"
                                  IsChecked="{Binding ShowAliveOnly}"
                                  Foreground="{DynamicResource SubtleFg}" FontSize="11"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource ThemedCheckBox}" />
                    </StackPanel>
                </Border>

                <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding FilteredResults}"
                          AutoGenerateColumns="False" IsReadOnly="True" Style="{DynamicResource ThemedDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{converters:Translate Key=ColStatus}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="●" />
                                                <Setter Property="Foreground" Value="{DynamicResource GreenColor}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
                                                        <Setter Property="Text" Value="○" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{converters:Translate Key=ColIp}" Binding="{Binding Ip}" Width="Auto"
                                            FontFamily="Consolas" />
                        <DataGridTextColumn Header="{converters:Translate Key=ColHostname}" Binding="{Binding Hostname}" Width="Auto"
                                            FontFamily="Consolas" />
                        <DataGridTextColumn Header="{converters:Translate Key=ColMac}" Binding="{Binding MacAddress}" Width="Auto"
                                            FontFamily="Consolas" />
                        <DataGridTextColumn Header="{converters:Translate Key=ColVendor}" Binding="{Binding Vendor}" Width="Auto"
                                            FontFamily="Consolas" />
                        <DataGridTextColumn Header="{converters:Translate Key=ColPorts}" Binding="{Binding OpenPortsString, Mode=OneWay}" Width="*"
                                            FontFamily="Consolas" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Bottom Bar -->
        <Border Grid.Row="3" Background="{DynamicResource CardBg}" Padding="12,6"
                CornerRadius="0,0,8,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,1,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubtleFg}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="CSV" Style="{DynamicResource FlatButton}"
                        Foreground="{DynamicResource GreenColor}" FontSize="11" Padding="8,3"
                        Command="{Binding ExportCsvCommand}"
                        Visibility="{Binding IsExportEnabled, Converter={StaticResource BoolToVis}}" />
                <Button Content="Excel" Style="{DynamicResource FlatButton}"
                        Foreground="{DynamicResource AccentColor}" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                        Command="{Binding ExportExcelCommand}"
                        Visibility="{Binding IsExportEnabled, Converter={StaticResource BoolToVis}}" />
                <Button Content="JSON" Style="{DynamicResource FlatButton}"
                        Foreground="{DynamicResource PurpleColor}" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                        Command="{Binding ExportJsonCommand}"
                        Visibility="{Binding IsExportEnabled, Converter={StaticResource BoolToVis}}" />
                <Button Content="{converters:Translate Key=AddToProbes}" Style="{DynamicResource AccentButton}"
                        FontSize="11" Padding="10,3" Margin="16,0,0,0"
                        Click="TransferToProbes_Click"
                        Visibility="{Binding IsExportEnabled, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
