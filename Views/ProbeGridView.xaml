<UserControl x:Class="IpScopePro.Views.ProbeGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IpScopePro.Views"
             xmlns:converters="clr-namespace:IpScopePro.Converters"
             xmlns:controls="clr-namespace:IpScopePro.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFmt" />
        <converters:DoubleFormatConverter x:Key="DoubleFmt" />

        <DataTemplate x:Key="MaximizedProbeTemplate" DataType="{x:Type views:ProbeCardView}">
            <Border Background="{Binding BackgroundColor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding History}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource WindowFg}" FontSize="11"
                             FontFamily="Consolas" Padding="8,4"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           Foreground="{Binding DataContext.StatsColor, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Run Text="{Binding Timestamp, Converter={StaticResource DateTimeFmt}, ConverterParameter='HH:mm:ss.fff'}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Status}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding RttMs, Converter={StaticResource DoubleFmt}, ConverterParameter='F1'}" />ms
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="1" Background="{DynamicResource CardStatsBg}" Padding="10,6">
                        <TextBlock Text="{Binding StatsText}"
                                   Foreground="{DynamicResource CardTextBright}" FontSize="11"
                                   FontFamily="Consolas" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Row="2" Background="{DynamicResource CardInputBg}" Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="14"
                                 Foreground="{DynamicResource CardTextBright}" Background="Transparent"
                                 BorderThickness="0" Padding="12,4"
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 IsReadOnly="{Binding IsRunning}" />

                        <Button Grid.Column="1" Content="{converters:Translate Key=Start}" MinWidth="100" Height="34"
                                Margin="4,0" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Padding="8,0"
                                Background="Transparent"
                                Foreground="{DynamicResource CardTextBright}"
                                BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                                Command="{Binding StartProbeCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Content="{converters:Translate Key=Stop}" MinWidth="100" Height="34"
                                Margin="0,0,12,0" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Padding="8,0"
                                Background="Transparent"
                                Foreground="{DynamicResource RedColor}"
                                BorderBrush="{DynamicResource RedColor}" BorderThickness="1"
                                Command="{Binding StopProbeCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state -->
        <Border Visibility="{Binding Probes.Count, Converter={StaticResource InverseBoolToVis}}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
            <StackPanel>
                <TextBlock Text="⬡" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedFg}" Margin="0,0,0,12" />
                <TextBlock Text="{converters:Translate Key=NoProbes}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource SubtleFg}" />
                <TextBlock Text="{converters:Translate Key=AddToStart}" FontSize="12"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedFg}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Scroll mode -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{DynamicResource ThemedScrollViewer}"
                      Visibility="{Binding IsScrollView, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Probes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:CenteredWrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:ProbeCardView Margin="4" Width="320" Height="215"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.MaximizedProbeVm, Converter={StaticResource InverseBoolToVis}, ConverterParameter=skip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fixed mode -->
        <Grid Visibility="{Binding IsScrollView, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="FixedGrid" />

            <!-- Overflow warning banner -->
            <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsFixedOverflowing, Converter={StaticResource BoolToVis}}"
                    Padding="12,10" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⚠" FontSize="16" Foreground="{DynamicResource YellowColor}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SubtleFg}">
                        <Run Text="{converters:Translate Key=CrowdedFixed}" FontWeight="SemiBold" />
                        <Run Text=" " FontWeight="SemiBold" />
                        <Run Text="{converters:Translate Key=SwitchToScrollHint}" Foreground="{DynamicResource MutedFg}" />
                    </TextBlock>

                    <Button Grid.Column="2" Content="{converters:Translate Key=SwitchToScroll}" Height="30"
                            Style="{DynamicResource AccentButton}" FontSize="11" Padding="12,4"
                            Command="{Binding ToggleScrollViewCommand}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Maximized probe overlay -->
        <Border Background="{DynamicResource WindowBg}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Visibility="{Binding MaximizedProbeVm, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Maximized header bar -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="▬" ToolTip="{converters:Translate Key=Restore}" Width="32" Height="32"
                                Style="{DynamicResource FlatButton}"
                                Foreground="{DynamicResource WindowFg}" FontSize="18"
                                Command="{Binding MaximizedProbeVm.ToggleMaximizeCommand}" />

                        <TextBlock Grid.Column="1" Text="{Binding MaximizedProbeVm.DisplayName}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{Binding MaximizedProbeVm.IpTextColor}"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="None" />

                        <Button Grid.Column="2" Content="✕" ToolTip="{converters:Translate Key=RemoveProbe}" Width="32" Height="32"
                                Style="{DynamicResource FlatButton}"
                                Foreground="{DynamicResource RedColor}" FontSize="16"
                                Click="MaximizedRemoveProbe_Click" Padding="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Maximized probe content via ContentControl -->
                <ContentControl Grid.Row="1" Margin="2"
                                Content="{Binding MaximizedProbeVm}"
                                ContentTemplate="{StaticResource MaximizedProbeTemplate}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
