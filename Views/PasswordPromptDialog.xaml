<Window x:Class="IpScopePro.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:IpScopePro.Converters"
        Title="{converters:Translate Key=PasswordTitle}" Height="230" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Segoe UI" FontSize="12">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                       GlassFrameThickness="0" CornerRadius="12" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitle" Grid.Column="0" Text="{converters:Translate Key=PasswordTitle}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource WindowFg}"
                               VerticalAlignment="Center" Margin="14,0" />
                    <Button Grid.Column="1" Content="✕" Width="36" Height="30"
                            Style="{DynamicResource FlatButton}"
                            Foreground="{DynamicResource RedColor}" FontSize="14" Click="Cancel_Click" />
                </Grid>
            </Border>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="20,18,20,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource WindowFg}" />

            <!-- Password -->
            <PasswordBox x:Name="PwBox" Grid.Row="2" Margin="20,12,20,0" Height="34"
                         Style="{DynamicResource ThemedPasswordBox}"
                         BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                         Padding="10,6" VerticalContentAlignment="Center" />

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,18,20,16">
                <Button Content="{converters:Translate Key=Cancel}" MinWidth="90" Height="32" Margin="0,0,8,0"
                        Style="{DynamicResource FlatButton}" Padding="10,4" Click="Cancel_Click" />
                <Button Content="{converters:Translate Key=Ok}" MinWidth="90" Height="32"
                        Style="{DynamicResource AccentButton}" Padding="10,4" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
