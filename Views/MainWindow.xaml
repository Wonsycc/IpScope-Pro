<Window x:Class="IpScopePro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:IpScopePro.Converters"
        xmlns:views="clr-namespace:IpScopePro.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1100"
        MinHeight="400" MinWidth="700"
        WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="4"
                       GlassFrameThickness="0" CornerRadius="8" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar (40px) -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="AppLogoImage" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="IpScope Pro" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource WindowFg}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button x:Name="ThemeButton" ToolTip="{converters:Translate Key=ToggleTheme}" Width="90" Height="32"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{DynamicResource FlatButton}"
                            Foreground="{DynamicResource SubtleFg}" Click="ToggleTheme_Click"
                            FontSize="11">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ThemeIconGlyph" Text="☀" FontSize="15" Margin="0,0,4,0" />
                                <TextBlock x:Name="ThemeLabel" Text="Claro" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Content="─" ToolTip="{converters:Translate Key=Minimize}" Width="34" Height="32"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{DynamicResource FlatButton}"
                            Foreground="{DynamicResource SubtleFg}" Click="Minimize_Click"
                            FontSize="15" />
                    <Button Content="□" ToolTip="{converters:Translate Key=Maximize}" Width="34" Height="32"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{DynamicResource FlatButton}"
                            Foreground="{DynamicResource SubtleFg}" Click="Maximize_Click"
                            FontSize="15" />
                    <Button Content="✕" ToolTip="{converters:Translate Key=Close}" Width="34" Height="32"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource SubtleFg}" Click="Close_Click"
                            FontSize="15" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource RedColor}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource RedColor}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">

                    <Button Width="56" Height="50" Margin="4,2" Padding="2"
                            Command="{Binding SelectProbeTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlay}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource SubtleFg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="⬡" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Text="{converters:Translate Key=NavProbe}" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                                       Foreground="{DynamicResource SubtleFg}" />
                        </StackPanel>
                    </Button>

                    <Button Width="56" Height="50" Margin="4,2" Padding="2"
                            Command="{Binding SelectScannerTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlay}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource SubtleFg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="⌕" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Text="{converters:Translate Key=NavScanner}" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                                       Foreground="{DynamicResource SubtleFg}" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="10,8" Background="{DynamicResource SeparatorColor}" />

                    <Button Width="56" Height="46" Margin="4,2"
                            Style="{DynamicResource FlatButton}" Padding="2"
                            Click="OpenSettings_Click">
                        <StackPanel>
                            <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SubtleFg}" />
                            <TextBlock Text="{converters:Translate Key=NavSettings}" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                                       Foreground="{DynamicResource SubtleFg}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SeparatorColor}" />

            <!-- Content area -->
            <Grid Grid.Column="2" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Probe Toolbar -->
                <Border Grid.Row="0" Padding="4,5"
                        Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"
                        Background="{DynamicResource SurfaceBg}" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="{converters:Translate Key=AddProbe}" ToolTip="{converters:Translate Key=AddProbeTip}" MinWidth="68" Height="32"
                                    Style="{DynamicResource AccentButton}" FontSize="11" Padding="10,2"
                                    Click="AddProbe_Click" />
                            <Button Content="{converters:Translate Key=StartAll}" ToolTip="{converters:Translate Key=StartAllTip}" MinWidth="88" Height="32"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2" Margin="6,0,0,0"
                                    Foreground="{DynamicResource GreenColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Command="{Binding StartAllProbesCommand}" />
                            <Button Content="{converters:Translate Key=StopAll}" ToolTip="{converters:Translate Key=StopAllTip}" MinWidth="88" Height="32"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2" Margin="4,0,0,0"
                                    Foreground="{DynamicResource RedColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Command="{Binding StopAllProbesCommand}" />
                            <Button Content="{converters:Translate Key=RemoveAll}" ToolTip="{converters:Translate Key=RemoveAllTip}" MinWidth="98" Height="32"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2" Margin="4,0,0,0"
                                    Foreground="{DynamicResource MutedFg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Click="RemoveAllProbes_Click" />

                            <!-- Scroll/Fixed toggle -->
                            <Button x:Name="ScrollViewButton" Height="32" Margin="12,0,0,0"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="8,2"
                                    Foreground="{DynamicResource SubtleFg}"
                                    Click="ToggleScrollView_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↕ " FontSize="12" />
                                    <TextBlock x:Name="ScrollViewLabel" Text="Scroll" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{converters:Translate Key=Batch}" ToolTip="{converters:Translate Key=BatchTip}" MinWidth="72" Height="32"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2"
                                    Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Click="BatchInput_Click" />
                            <Button Content="{converters:Translate Key=Import}" MinWidth="62" Height="32"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2" Margin="6,0,0,0"
                                    Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Command="{Binding ImportProbesCommand}" />
                            <Button Content="{converters:Translate Key=Export}" MinWidth="62" Height="32"
                                    Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2" Margin="6,0,0,0"
                                    Foreground="{DynamicResource GreenColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    Command="{Binding ExportProbesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Views (switched by tab) -->
                <views:ProbeGridView DataContext="{Binding}" Grid.Row="1"
                    Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                <views:ScannerView x:Name="ScannerViewControl" Grid.Row="1"
                    Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <tb:TaskbarIcon x:Name="TrayIcon"
                            IconSource="/Resources/app.ico"
                            ToolTipText="IpScope Pro"
                            Visibility="Visible"
                            TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{converters:Translate Key=Open}" Click="TrayOpen_Click" />
                        <Separator />
                        <MenuItem Header="{converters:Translate Key=Exit}" Click="TrayExit_Click" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Grid>
</Window>
