<Window x:Class="IpScopePro.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:IpScopePro.Converters"
        Title="{converters:Translate Key=SettingsTitle}" Height="560" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource WindowFg}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <converters:HexToColorConverter x:Key="HexToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                       GlassFrameThickness="0" CornerRadius="12" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBg}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{converters:Translate Key=SettingsHeader}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource WindowFg}" VerticalAlignment="Center" Margin="12,0" />
            </Border>

            <TabControl Grid.Row="1" Background="{StaticResource WindowBg}" BorderThickness="0" Margin="14,10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource SubtleFg}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="FontFamily" Value="Segoe UI" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                          TextElement.FontFamily="{TemplateBinding FontFamily}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverOverlay}" />
                                            <Setter Property="Foreground" Value="{StaticResource WindowFg}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- General Tab -->
                <TabItem Header="{converters:Translate Key=TabGeneral}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel>
                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=LanguageGroup}" Foreground="{StaticResource AccentColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=LanguageGroup}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex}" Width="160" HorizontalAlignment="Right"
                                                  Style="{StaticResource ThemedComboBox}" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Español" />
                                            <ComboBoxItem Content="English" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Ping Tab -->
                <TabItem Header="{converters:Translate Key=TabPing}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel>
                            <GroupBox Header="{converters:Translate Key=Timing}" Style="{StaticResource ThemedGroupBox}">
                                <StackPanel Margin="10">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=PingInterval}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding PingIntervalMs}" Width="100" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=PingTimeout}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding PingTimeoutMs}" Width="100" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=FailedPingsDown}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding FailedPingsBeforeDown}" Width="100" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=HighLatency}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding HighLatencyThresholdMs}" Width="100" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=ConcurrentPings}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding ConcurrentPingsLimit}" Width="100" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Notifications Tab -->
                <TabItem Header="{converters:Translate Key=TabNotifications}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel>
                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=WindowsGroup}" Foreground="{StaticResource AccentColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <CheckBox Content="{converters:Translate Key=EnableNotifications}" IsChecked="{Binding NotificationsEnabled}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                                    <CheckBox Content="{converters:Translate Key=WindowsToast}" IsChecked="{Binding WindowsNotificationsEnabled}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=CooldownSec}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding WindowsCooldownSeconds}" Width="80" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=EmailSmtp}" Foreground="{StaticResource YellowColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <CheckBox Content="{converters:Translate Key=EnableEmail}" IsChecked="{Binding EmailEnabled}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=CooldownSec}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding EmailCooldownSeconds}" Width="80" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=SmtpServer}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding SmtpServer}" Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=SmtpPort}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding SmtpPort}" Width="80" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Email}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding SmtpUsername}" Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Password}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <PasswordBox x:Name="SmtpPasswordBox" Grid.Column="1" Style="{StaticResource ThemedPasswordBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{converters:Translate Key=To}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                            <TextBlock Text=" ⓘ" VerticalAlignment="Center" FontSize="14"
                                                       Foreground="{StaticResource BlueColor}" Cursor="Help"
                                                       ToolTipService.InitialShowDelay="0"
                                                       ToolTipService.ShowDuration="6000">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Text="{converters:Translate Key=ToTip}"
                                                               FontSize="12" Foreground="{StaticResource WindowFg}" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding EmailTo}" Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Button Content="{converters:Translate Key=SendTestEmail}" MinWidth="130" Height="28" Margin="0,8,0,0"
                                            Style="{DynamicResource FlatButton}" Padding="12,4"
                                            Foreground="{StaticResource AccentColor}" FontSize="11"
                                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            Click="TestEmail_Click" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=Telegram}" Foreground="{StaticResource BlueColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <CheckBox Content="{converters:Translate Key=EnableTelegram}" IsChecked="{Binding TelegramEnabled}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=CooldownSec}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding TelegramCooldownSeconds}" Width="80" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=BotToken}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding TelegramBotToken}" Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=ChatId}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding TelegramChatId}" Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Button Content="{converters:Translate Key=SendTestTelegram}" MinWidth="140" Height="28" Margin="0,8,0,0"
                                            Style="{DynamicResource FlatButton}" Padding="12,4"
                                            Foreground="{StaticResource BlueColor}" FontSize="11"
                                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            Click="TestTelegram_Click" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=Audio}" Foreground="{StaticResource GreenColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <CheckBox Content="{converters:Translate Key=EnableAudio}" IsChecked="{Binding AudioEnabled}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,4" />
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=CooldownSec}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding AudioCooldownSeconds}" Width="80" HorizontalAlignment="Right"
                                                 Style="{StaticResource ThemedTextBox}" />
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=SoundFile}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding AudioFilePath}" IsReadOnly="True"
                                                 Style="{StaticResource ThemedTextBox}" Foreground="{StaticResource MutedFg}" />
                                        <Button Grid.Column="2" Content="..." Width="32" Height="28"
                                                Style="{DynamicResource FlatButton}"
                                                Foreground="{StaticResource AccentColor}" FontSize="14"
                                                Command="{Binding BrowseAudioFileCommand}" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Colors Tab -->
                <TabItem Header="{converters:Translate Key=TabColors}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel>
                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=DarkThemeGroup}" Foreground="{StaticResource AccentColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="16,12">

                                    <!-- Up -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Up}" Foreground="{StaticResource GreenColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorUp" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorUp, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorUp, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Down -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Down}" Foreground="{StaticResource RedColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorDown" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorDown, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorDown, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Error -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Error}" Foreground="{StaticResource OrangeColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorError" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorError, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorError, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Latency -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Latency}" Foreground="{StaticResource YellowColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorLatencyHigh" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorLatencyHigh, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorLatencyHigh, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Indeterminate -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Indeterm}" Foreground="{StaticResource MutedFg}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorIndeterminate" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorIndeterminate, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorIndeterminate, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Inactive -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Inactive}" Foreground="{StaticResource SubtleFg}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorInactive" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorInactive, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorInactive, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- IP Text -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=IpText}" Foreground="{StaticResource TealColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorIpAddress" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorIpAddress, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                </StackPanel>
                            </GroupBox>

                            <!-- Shared Color Picker Popup -->
                            <Popup x:Name="ColorPopup" StaysOpen="False" Placement="Mouse"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="10" Padding="14"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <UniformGrid Columns="8" Rows="3" Margin="0,0,0,10">
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#F1F5F9" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 100" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#CBD5E1" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 300" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#94A3B8" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 400" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#64748B" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 500" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#475569" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 600" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#334155" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 700" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#1E293B" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 800" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#0F172A" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Slate 900" />

                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#FEE2E2" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Red 100" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#F87171" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Red 400" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#DC2626" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Red 600" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#FED7AA" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Orange 200" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#F97316" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Orange 500" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#EA580C" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Orange 600" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#FDE68A" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Amber 200" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#D97706" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Amber 600" />

                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#BBF7D0" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Green 200" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#22C55E" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Green 500" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#166534" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Green 800" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#BAE6FD" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Sky 200" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#0EA5E9" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Sky 500" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#0284C7" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Sky 600" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#BFDBFE" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Blue 200" />
                                            <Border Width="34" Height="34" Margin="3" CornerRadius="6" Cursor="Hand"
                                                    Background="#2563EB" MouseLeftButtonDown="PresetColor_Click"
                                                    ToolTip="Blue 600" />
                                        </UniformGrid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PopupHexInput" Grid.Column="0" Width="130" FontFamily="Consolas"
                                                     FontSize="12" Style="{StaticResource ThemedTextBox}"
                                                     VerticalContentAlignment="Center" />
                                            <Button Grid.Column="1" Content="{converters:Translate Key=Apply}" MinWidth="56" Height="28" Margin="6,0,0,0"
                                                    Style="{DynamicResource AccentButton}" FontSize="11" Padding="8,0"
                                                    Click="PopupHexOk_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Light Theme Colors -->
                            <GroupBox Style="{StaticResource ThemedGroupBox}" Margin="0,10,0,0">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=LightThemeGroup}" Foreground="{StaticResource YellowColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="16,12">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Up}" Foreground="{StaticResource GreenColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorUpLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorUpLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorUpLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Down}" Foreground="{StaticResource RedColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorDownLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorDownLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorDownLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Error}" Foreground="{StaticResource OrangeColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorErrorLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorErrorLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorErrorLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Latency}" Foreground="{StaticResource YellowColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorLatencyHighLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorLatencyHighLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorLatencyHighLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Indeterm}" Foreground="{StaticResource MutedFg}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorIndeterminateLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorIndeterminateLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorIndeterminateLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=Inactive}" Foreground="{StaticResource SubtleFg}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorInactiveLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorInactiveLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorInactiveLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- IP Text -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=IpText}" Foreground="{StaticResource TealColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" />
                                        <Button Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                                                Tag="ColorIpAddressLight" Click="ColorSwatch_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding ColorIpAddressLight, Converter={StaticResource HexToColor}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding ColorIpAddressLight, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" Style="{StaticResource ThemedTextBox}"
                                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="{converters:Translate Key=RestoreDefaults}" MinWidth="150" Height="34" Margin="0,10,0,0"
                                    Style="{DynamicResource FlatButton}" Padding="12,4"
                                    Foreground="{StaticResource MutedFg}" FontSize="12"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Command="{Binding ResetColorsCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Startup Tab -->
                <TabItem Header="{converters:Translate Key=TabStartup}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel>
                            <GroupBox Style="{StaticResource ThemedGroupBox}">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=ApplicationGroup}" Foreground="{StaticResource RedColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <CheckBox Content="{converters:Translate Key=MinimizeToTray}" IsChecked="{Binding MinimizeToTray}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,5" />
                                    <CheckBox Content="{converters:Translate Key=StartWithWindows}" IsChecked="{Binding StartWithWindows}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,5"
                                              Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox Content="{converters:Translate Key=LogToFile}" IsChecked="{Binding LogToFile}"
                                              Style="{StaticResource ThemedCheckBox}" Margin="0,5" />
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{converters:Translate Key=LogDirectory}" VerticalAlignment="Center" Foreground="{StaticResource SubtleFg}" />
                                        <TextBox Grid.Column="1" Text="{Binding LogDirectory}" IsReadOnly="True"
                                                 Style="{StaticResource ThemedTextBox}" Foreground="{StaticResource MutedFg}" />
                                        <Button Grid.Column="2" Content="..." Width="32" Height="28" Margin="6,0,0,0"
                                                Style="{DynamicResource FlatButton}"
                                                Foreground="{StaticResource AccentColor}" FontSize="14"
                                                Command="{Binding BrowseLogDirectoryCommand}" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource ThemedGroupBox}" Margin="0,10,0,0">
                                <GroupBox.Header>
                                    <TextBlock Text="{converters:Translate Key=InstallGroup}" Foreground="{StaticResource AccentColor}" />
                                </GroupBox.Header>
                                <StackPanel Margin="10">
                                    <TextBlock Text="{converters:Translate Key=InstallHint}" Foreground="{StaticResource SubtleFg}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Content="{converters:Translate Key=InstallApp}" MinWidth="170" Height="32" HorizontalAlignment="Left"
                                            Style="{DynamicResource AccentButton}" FontSize="11" Padding="12,4"
                                            Click="Install_Click"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button Content="{converters:Translate Key=UninstallApp}" MinWidth="170" Height="32" HorizontalAlignment="Left"
                                            Style="{DynamicResource DangerButton}" FontSize="11" Padding="12,4" Margin="0,8,0,0"
                                            Click="Uninstall_Click"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="14" Background="{StaticResource TitleBarBg}" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="{converters:Translate Key=ExportSettings}" MinWidth="110" Height="32"
                                Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2"
                                Foreground="{StaticResource AccentColor}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Click="ExportSettings_Click" />
                        <Button Content="{converters:Translate Key=ImportSettings}" MinWidth="110" Height="32" Margin="8,0,0,0"
                                Style="{DynamicResource FlatButton}" FontSize="11" Padding="10,2"
                                Foreground="{StaticResource GreenColor}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Click="ImportSettings_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{converters:Translate Key=Cancel}" MinWidth="90" Height="34"
                                Style="{DynamicResource FlatButton}" Padding="10,4"
                                Foreground="{StaticResource SubtleFg}" FontSize="12" Click="Close_Click" />
                        <Button Content="{converters:Translate Key=Save}" MinWidth="90" Height="34" Margin="10,0,0,0"
                                Style="{DynamicResource AccentButton}" Padding="10,4"
                                FontSize="12" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
